rules_version = '2';

// Firebase Cloud Storage Security Rules for OPRONIX Fire Safety Solutions
service firebase.storage {
  match /b/{bucket}/o {
    
    // Product Images: Public read access so all customers and site inspectors can view equipment photos
    // Write access restricted to authenticated administrators, with max 5MB size limit and image content-type validation
    match /product_images/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if request.auth != null;
    }

    // Quotation attachments and site inspection photos
    match /quotations/{quotationId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size <= 10 * 1024 * 1024;
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
